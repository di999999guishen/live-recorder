# 复制成 .env 后按需填写。所有项都可留空，留空则走默认行为。

# ---------- 抖音 ----------
# 风控变严导致拿不到数据时再填，从浏览器复制整条 Cookie
DOUYIN_COOKIE=

# 桌面 UA，默认已内置 Chrome 124
# DOUYIN_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ---------- 录制 ----------
# audio（仅音轨，约 51MB/h）| video（含画面，2-4GB/h）
RECORD_MODE=audio

# 视频模式下的画质：ORIGION / FULL_HD1 / HD1 / SD1 / SD2
RECORD_QUALITY=HD1

# 单个分片秒数，仅 video 模式强制分片
SEGMENT_SECONDS=1800

# 单场最长录制秒数，超时自动停录
MAX_RECORD_SECONDS=21600

# 轮询间隔秒数
POLL_INTERVAL=60

# ---------- 转写（可选）----------
# 含 CUDA 轮子的 site-packages 路径；留空则自动探测当前解释器与项目内 venv/
# DLR_SITE_PACKAGES=
# 强制离线加载 Whisper 模型（模型已在 ~/.cache/huggingface 时建议开启）
HF_HUB_OFFLINE=1

# ---------- 出稿笔记目录（可选）----------
# digest.py 出稿的输出目录，catchup.py --purge 用它判断「出稿 md 是否已落地」；
# 留空则用项目内 notes/
# DLR_NOTES_DIR=D:\Note\直播监控

# ---------- 数据 / 日志目录（可选）----------
# 留空则用项目内 data/ 与 logs/。数据盘另置、或想分析别处的录制产物时再改。
# DLR_DATA_DIR=E:\录像归档
# DLR_LOG_DIR=E:\录像归档\logs

# ---------- 主播配置（可选）----------
# 多个文件用 ; 分隔。留空则自动扫描项目内 anchors*.json（取其中的 alias 作主播名）。
# DLR_ANCHORS=anchors.json;anchors_wulin.json

# ---------- LLM 总结（可选，pipeline/summarizer.py 使用）----------
# 任意 OpenAI 兼容接口；不填则回退智谱 GLM-4-Flash 默认地址
LLM_API_KEY=
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 出稿模型建议 glm-4-air 起步：flash 系列（flash/flashx）不遵守「按话题归纳」约束，
# 会把「核心观点」写成几百条逐句搬运（详见 README 坑位 28）。air 便宜且合规。
# SUMMARY_MODEL=glm-4-air

# ---------- 邮件通知（可选）----------
# 配齐 host/user/pass 则走 SMTP 直发，否则落到 outbox/ 队列
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
